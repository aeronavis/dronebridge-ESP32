/*
 * Default Wi-Fi credentials (station mode) used on first boot and after a button press.
 * Copy this file to db_credentials.h in the same folder and fill in your network.
 * db_credentials.h is listed in .gitignore and is never committed.
 */
#ifndef DB_CREDENTIALS_H
#define DB_CREDENTIALS_H

#define DB_DEFAULT_WIFI_SSID "your-ssid"
#define DB_DEFAULT_WIFI_PWD "your-password"

#endif
